<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FocusMate" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/focusmate_primary</item>
        <item name="colorPrimaryVariant">@color/focusmate_secondary</item>
        <item name="colorSecondary">@color/focusmate_accent</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/white</item>

        <item name="android:windowBackground">@color/focusmate_bg</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Widget.FocusMate.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/focusmate_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="rippleColor">@color/focusmate_secondary</item>
    </style>

    <style name="Widget.FocusMate.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/focusmate_primary</item>
        <item name="android:textColor">@color/focusmate_primary</item>
    </style>
</resources>
